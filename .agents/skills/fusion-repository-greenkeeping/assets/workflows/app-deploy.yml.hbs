{{!--
Manual app build and sequential publication from trusted default-branch code. Agent fills by hand; follow fill rules in references/common-workflows.md.
workingDirectory: repository-relative app root, . or [A-Za-z0-9_][A-Za-z0-9_./-]* without ..; holds app lockfile, manifest and local CLI.
appKey: registered app key, 1-128 of letters, digits, dot, underscore, hyphen; starts alphanumeric.
publishConfig: true generates config per environment (needs app.config file); false skips it.
environments: ordered unique list from ci, fqa, fprd, tr, next; lowercase; each is also an existing protected GitHub environment name.
tag: publish tag, 1-128 of letters, digits, dot, hyphen; starts alphanumeric; no underscores.
nodeVersion: exact even Node x.y.z, major 24 or newer.
packageManagerVersion: exact x.y.z matching package.json packageManager for pnpm/Bun; empty for npm.
isNpm: true only when packageManager is npm.
isPnpm: true only when packageManager is pnpm.
isBun: true only when packageManager is bun.
azureClientIdVariable: Actions variable name holding client ID; [A-Za-z_][A-Za-z0-9_]*, not GITHUB_/RUNNER_; never the value.
azureTenantIdVariable: Actions variable name holding tenant ID; same naming rule.
azureResourceIdVariable: Actions variable name holding Fusion API audience; same naming rule.
--}}
# fusion-workflow-template: app-deploy
# fusion-workflow-version: 1.0.0
# fusion-workflow-source: https://github.com/equinor/fusion-skills/blob/main/skills/.experimental/fusion-repository-greenkeeping/assets/workflows/app-deploy.yml.hbs
# fusion-workflow-owner: @equinor/fusion-core
# Record source pin and raw inputs in .github/workflows/app-deploy.inputs.json.
name: Deploy Fusion app

on:
  workflow_dispatch:
    inputs:
      environment:
        description: Fusion environment; all deploys every environment in order.
        type: choice
        default: all
        options:
          - all
{{#each environments}}
          - "{{this}}"
{{/each}}

permissions:
  contents: read

# A newer deployment of the same app supersedes one still running or waiting.
concurrency:
  group: "app-deploy-{{appKey}}"
  cancel-in-progress: true

env:
  APP_DIRECTORY: "{{workingDirectory}}"
  EXPECTED_APP_KEY: "{{appKey}}"
  PUBLISH_TAG: "{{tag}}"
  DEPLOY_ENVIRONMENTS: >-
{{#each environments}}
    {{this}}
{{/each}}
  CLIENT_ID_VARIABLE: "{{azureClientIdVariable}}"
  TENANT_ID_VARIABLE: "{{azureTenantIdVariable}}"
  RESOURCE_ID_VARIABLE: "{{azureResourceIdVariable}}"

jobs:
  build:
    if: $\{{ github.ref == format('refs/heads/{0}', github.event.repository.default_branch) }}
    runs-on: ubuntu-latest
    permissions:
      contents: read
    outputs:
      environments: $\{{ steps.targets.outputs.environments }}
    defaults:
      run:
        shell: bash
        working-directory: $\{{ env.APP_DIRECTORY }}
    steps:
      - name: Check out trusted default branch
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Set up supported Node
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: "{{nodeVersion}}"
          # Automatic npm caching follows the root package.json and lockfile, not the
          # install directory, and is discouraged for privileged jobs.
          package-manager-cache: false
{{#if isNpm}}

      - name: Install locked app dependencies
        run: npm ci
{{/if}}
{{#if isPnpm}}

      - name: Set up pinned pnpm
        uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
        with:
          version: "{{packageManagerVersion}}"
          package_json_file: $\{{ env.APP_DIRECTORY }}/package.json

      - name: Install locked app dependencies
        run: pnpm install --frozen-lockfile
{{/if}}
{{#if isBun}}

      - name: Set up pinned Bun
        uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0
        with:
          bun-version: "{{packageManagerVersion}}"

      - name: Install locked app dependencies
        run: bun install --frozen-lockfile
{{/if}}

      # Lockfile-pinned local CLI packs; no registry download or version drift at build time.
      - name: Pack and verify target app
        run: |
          ./node_modules/.bin/fusion-framework-cli app pack --archive app-bundle.zip
          if ! unzip -p app-bundle.zip metadata.json |
               jq -e --arg app "$EXPECTED_APP_KEY" '.appKey == $app' > /dev/null; then
            echo "::error::Packed app identity does not match appKey. Review the manifest before publishing."
            exit 1
          fi

      - name: Select target environments
        id: targets
        env:
          SELECTED_ENVIRONMENT: $\{{ inputs.environment }}
        run: |
          read -ra environments <<< "$DEPLOY_ENVIRONMENTS"
          if [ "$SELECTED_ENVIRONMENT" != all ]; then
            if [[ " ${environments[*]} " != *" $SELECTED_ENVIRONMENT "* ]]; then
              echo "::error::Unknown environment $SELECTED_ENVIRONMENT."
              exit 1
            fi
            environments=("$SELECTED_ENVIRONMENT")
          fi
          printf 'environments=%s\n' "$(jq -cn '$ARGS.positional' --args "${environments[@]}")" >> "$GITHUB_OUTPUT"

      - name: Upload verified bundle
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: app-bundle
          path: $\{{ env.APP_DIRECTORY }}/app-bundle.zip
          if-no-files-found: error

  deploy:
    needs: build
    runs-on: ubuntu-latest
    # One environment at a time, in listed order; protection rules gate each step
    # and a failure stops later environments.
    strategy:
      max-parallel: 1
      matrix:
        environment: $\{{ fromJSON(needs.build.outputs.environments) }}
    environment: $\{{ matrix.environment }}
    permissions:
      contents: read
      id-token: write
    defaults:
      run:
        shell: bash
        working-directory: $\{{ env.APP_DIRECTORY }}
    steps:
{{#if publishConfig}}
      - name: Check out trusted default branch
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Set up supported Node
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: "{{nodeVersion}}"
          # Automatic npm caching follows the root package.json and lockfile, not the
          # install directory, and is discouraged for privileged jobs.
          package-manager-cache: false
{{#if isNpm}}

      - name: Install locked app dependencies
        run: npm ci
{{/if}}
{{#if isPnpm}}

      - name: Set up pinned pnpm
        uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
        with:
          version: "{{packageManagerVersion}}"
          package_json_file: $\{{ env.APP_DIRECTORY }}/package.json

      - name: Install locked app dependencies
        run: pnpm install --frozen-lockfile
{{/if}}
{{#if isBun}}

      - name: Set up pinned Bun
        uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0
        with:
          bun-version: "{{packageManagerVersion}}"

      - name: Install locked app dependencies
        run: bun install --frozen-lockfile
{{/if}}

{{/if}}
      - name: Download verified bundle
        uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: app-bundle
          path: $\{{ env.APP_DIRECTORY }}
{{#if publishConfig}}

      # Runs inside the environment job so environment-scoped variables reach the config.
      - name: Generate environment app config
        env:
          FUSION_ENVIRONMENT: $\{{ matrix.environment }}
        run: |
          config=app.config
          for extension in ts js json; do
            if [ -f "app.config.$FUSION_ENVIRONMENT.$extension" ]; then
              config="app.config.$FUSION_ENVIRONMENT.$extension"
              break
            fi
          done
          ./node_modules/.bin/fusion-framework-cli app config "$config" --env "$FUSION_ENVIRONMENT" --output app-config.generated.json
{{/if}}

      - name: Publish verified bundle
        uses: equinor/fusion-action-app-publish@c88d76012b79e374d0447915e84ba31e7b65d543 # v2.2.2
        with:
          # Absolute: the action resolves artifact paths against this value from inside it.
          working-directory: $\{{ github.workspace }}/$\{{ env.APP_DIRECTORY }}
          artifact: app-bundle.zip
{{#if publishConfig}}
          config: app-config.generated.json
{{/if}}
          env: $\{{ matrix.environment }}
          tag: $\{{ env.PUBLISH_TAG }}
          azure-client-id: $\{{ vars[env.CLIENT_ID_VARIABLE] }}
          azure-tenant-id: $\{{ vars[env.TENANT_ID_VARIABLE] }}
          azure-resource-id: $\{{ vars[env.RESOURCE_ID_VARIABLE] }}
          allow-existing-version: "false"
