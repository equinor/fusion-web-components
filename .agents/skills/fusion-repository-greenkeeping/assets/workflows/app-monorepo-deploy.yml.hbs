{{!--
Changesets release management, then build once and sequential publication of the released allowlisted app. Agent fills by hand; follow fill rules in references/common-workflows.md.
defaultBranch: repository default branch, literal Git branch name.
packageManager: npm, pnpm or bun; runs root version/release scripts.
versionScript: existing root package.json script name [A-Za-z0-9][A-Za-z0-9:._-]*, never a command.
releaseScript: existing root package.json script name, same rule; tags releases, e.g. changeset git-tag.
prereleaseTag: publish tag for GitHub prereleases; same rule as tag.
releaseTokenSecret: GitHub App/PAT Actions secret name [A-Za-z_][A-Za-z0-9_]*, not GITHUB_*; no github.token fallback.
appsJson: compact single-line JSON array, one object per app {packageName, workingDirectory, appKey, publishConfig}; packageName is full lowercase package.json name incl. scope; workingDirectory and appKey follow single-app rules; publishConfig boolean; all three strings unique across apps.
environments: ordered unique list from ci, fqa, fprd, tr, next; lowercase; each is also an existing protected GitHub environment name.
tag: publish tag, 1-128 of letters, digits, dot, hyphen; starts alphanumeric; no underscores.
nodeVersion: exact even Node x.y.z, major 24 or newer.
packageManagerVersion: exact x.y.z matching package.json packageManager for pnpm/Bun; empty for npm.
isNpm: true only when packageManager is npm.
isPnpm: true only when packageManager is pnpm.
isBun: true only when packageManager is bun.
azureClientIdVariable: Actions variable name holding client ID; [A-Za-z_][A-Za-z0-9_]*, not GITHUB_/RUNNER_; never the value.
azureTenantIdVariable: Actions variable name holding tenant ID; same naming rule.
azureResourceIdVariable: Actions variable name holding Fusion API audience; same naming rule.
--}}
# fusion-workflow-template: app-monorepo-deploy
# fusion-workflow-version: 1.0.0
# fusion-workflow-source: https://github.com/equinor/fusion-skills/blob/main/skills/.experimental/fusion-repository-greenkeeping/assets/workflows/app-monorepo-deploy.yml.hbs
# fusion-workflow-owner: @equinor/fusion-core
# Record source pin and raw inputs in .github/workflows/app-monorepo-deploy.inputs.json.
name: Release and deploy Fusion apps

# Push runs Changesets. Each published per-package release then triggers this workflow
# again, so a release deploys only its own app.
on:
  push:
    branches: ["{{defaultBranch}}"]
  release:
    types: [published]

permissions:
  contents: read

env:
  CLIENT_ID_VARIABLE: "{{azureClientIdVariable}}"
  TENANT_ID_VARIABLE: "{{azureTenantIdVariable}}"
  RESOURCE_ID_VARIABLE: "{{azureResourceIdVariable}}"

jobs:
  release:
    if: $\{{ github.event_name == 'push' && github.ref == format('refs/heads/{0}', github.event.repository.default_branch) }}
    runs-on: ubuntu-latest
    concurrency:
      group: fusion-changesets-$\{{ github.repository }}
      cancel-in-progress: false
    permissions:
      contents: write
      pull-requests: write
    env:
      RELEASE_TOKEN_SECRET: "{{releaseTokenSecret}}"
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: "{{nodeVersion}}"
          # Automatic npm caching follows the root package.json and lockfile, not the
          # install directory, and is discouraged for privileged jobs.
          package-manager-cache: false
{{#if isNpm}}
      - name: Install locked workspace dependencies
        run: npm ci
{{/if}}
{{#if isPnpm}}
      - uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
        with:
          version: "{{packageManagerVersion}}"
      - name: Install locked workspace dependencies
        run: pnpm install --frozen-lockfile
{{/if}}
{{#if isBun}}
      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0
        with:
          bun-version: "{{packageManagerVersion}}"
      - name: Install locked workspace dependencies
        run: bun install --frozen-lockfile
{{/if}}
      # Releases created with github.token never trigger workflows, so the release
      # event that deploys apps needs a GitHub App or scoped PAT token.
      - name: Require release-event credential
        env:
          RELEASE_TOKEN: $\{{ secrets[env.RELEASE_TOKEN_SECRET] }}
        run: |
          if [ -z "$RELEASE_TOKEN" ]; then
            echo "::error::Configure the named GitHub App/PAT secret. github.token-created releases do not trigger release workflows."
            exit 1
          fi
      - name: Create release PR or publish releases
        uses: changesets/action@ae32849d5ba541f9ae29e40e22a623bc13562f51 # v2.1.2
        with:
          github-token: $\{{ secrets[env.RELEASE_TOKEN_SECRET] }}
          pr-title: "chore(release): version Fusion apps"
          pr-draft: always
          create-github-releases: true
          version-script: "{{packageManager}} run {{versionScript}}"
          publish-script: "{{packageManager}} run {{releaseScript}}"

  released-app:
    if: $\{{ github.event_name == 'release' }}
    runs-on: ubuntu-latest
    outputs:
      package-name: $\{{ steps.select.outputs.package-name }}
      working-directory: $\{{ steps.select.outputs.working-directory }}
      app-key: $\{{ steps.select.outputs.app-key }}
      publish-config: $\{{ steps.select.outputs.publish-config }}
      tag: $\{{ steps.select.outputs.tag }}
    steps:
      # Changesets tags each package as <packageName>@<version>; only allowlisted apps deploy.
      - name: Select released app
        id: select
        env:
          APP_TARGETS: '{{appsJson}}'
          RELEASE_TAG: $\{{ github.event.release.tag_name }}
          IS_PRERELEASE: $\{{ github.event.release.prerelease }}
          STABLE_TAG: "{{tag}}"
          PRERELEASE_TAG: "{{prereleaseTag}}"
        run: |
          app=$(jq -c --arg name "${RELEASE_TAG%@*}" 'map(select(.packageName == $name)) | first // empty' <<< "$APP_TARGETS")
          if [ -z "$app" ]; then
            echo "Release $RELEASE_TAG is not a configured Fusion app; no app deployment."
            exit 0
          fi
          publish_tag=$STABLE_TAG
          if [ "$IS_PRERELEASE" = true ]; then publish_tag=$PRERELEASE_TAG; fi
          jq -r --arg tag "$publish_tag" '"package-name=\(.packageName)", "working-directory=\(.workingDirectory)", "app-key=\(.appKey)", "publish-config=\(.publishConfig)", "tag=\($tag)"' <<< "$app" >> "$GITHUB_OUTPUT"

  build:
    needs: released-app
    if: $\{{ needs.released-app.outputs.app-key != '' }}
    runs-on: ubuntu-latest
    concurrency:
      group: $\{{ format('app-build-{0}', needs.released-app.outputs.app-key) }}
      cancel-in-progress: true
    permissions:
      contents: read
    env:
      EXPECTED_APP_KEY: $\{{ needs.released-app.outputs.app-key }}
    defaults:
      run:
        shell: bash
        working-directory: $\{{ needs.released-app.outputs.working-directory }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: $\{{ github.sha }}
          persist-credentials: false
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: "{{nodeVersion}}"
          # Automatic npm caching follows the root package.json and lockfile, not the
          # install directory, and is discouraged for privileged jobs.
          package-manager-cache: false
{{#if isNpm}}
      - name: Install locked workspace dependencies
        working-directory: .
        run: npm ci
{{/if}}
{{#if isPnpm}}
      - uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
        with:
          version: "{{packageManagerVersion}}"
      - name: Install locked workspace dependencies
        working-directory: .
        run: pnpm install --frozen-lockfile
{{/if}}
{{#if isBun}}
      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0
        with:
          bun-version: "{{packageManagerVersion}}"
      - name: Install locked workspace dependencies
        working-directory: .
        run: bun install --frozen-lockfile
{{/if}}
      # Lockfile-pinned local CLI packs; no registry download or version drift at build time.
      - name: Pack and verify released app
        run: |
          "$GITHUB_WORKSPACE/node_modules/.bin/fusion-framework-cli" app pack --archive app-bundle.zip
          if ! unzip -p app-bundle.zip metadata.json |
               jq -e --arg app "$EXPECTED_APP_KEY" '.appKey == $app' > /dev/null; then
            echo "::error::Packed app identity does not match configured appKey."
            exit 1
          fi
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: app-bundle
          path: $\{{ needs.released-app.outputs.working-directory }}/app-bundle.zip
          if-no-files-found: error

  deploy:
    needs: [released-app, build]
    runs-on: ubuntu-latest
    # One environment at a time, in listed order; protection rules gate each step
    # and a failure stops later environments.
    strategy:
      max-parallel: 1
      matrix:
        environment:
{{#each environments}}
          - "{{this}}"
{{/each}}
    environment: $\{{ matrix.environment }}
    # Per environment: a newer release of the same app supersedes this one there.
    concurrency:
      group: $\{{ format('app-deploy-{0}-{1}', needs.released-app.outputs.app-key, matrix.environment) }}
      cancel-in-progress: true
    permissions:
      contents: read
      id-token: write
    env:
      APP_DIRECTORY: $\{{ needs.released-app.outputs.working-directory }}
      PUBLISH_CONFIG: $\{{ needs.released-app.outputs.publish-config }}
    defaults:
      run:
        shell: bash
        working-directory: $\{{ needs.released-app.outputs.working-directory }}
    steps:
      # Config needs workspace sources and the locked CLI; bundle-only apps skip both.
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        if: env.PUBLISH_CONFIG == 'true'
        with:
          ref: $\{{ github.sha }}
          persist-credentials: false
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        if: env.PUBLISH_CONFIG == 'true'
        with:
          node-version: "{{nodeVersion}}"
          package-manager-cache: false
{{#if isNpm}}
      - name: Install locked workspace dependencies
        if: env.PUBLISH_CONFIG == 'true'
        working-directory: .
        run: npm ci
{{/if}}
{{#if isPnpm}}
      - uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
        if: env.PUBLISH_CONFIG == 'true'
        with:
          version: "{{packageManagerVersion}}"
      - name: Install locked workspace dependencies
        if: env.PUBLISH_CONFIG == 'true'
        working-directory: .
        run: pnpm install --frozen-lockfile
{{/if}}
{{#if isBun}}
      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0
        if: env.PUBLISH_CONFIG == 'true'
        with:
          bun-version: "{{packageManagerVersion}}"
      - name: Install locked workspace dependencies
        if: env.PUBLISH_CONFIG == 'true'
        working-directory: .
        run: bun install --frozen-lockfile
{{/if}}
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: app-bundle
          path: $\{{ env.APP_DIRECTORY }}
      # Runs inside the environment job so environment-scoped variables reach the config.
      - name: Generate environment app config
        if: env.PUBLISH_CONFIG == 'true'
        env:
          FUSION_ENVIRONMENT: $\{{ matrix.environment }}
        run: |
          config=app.config
          for extension in ts js json; do
            if [ -f "app.config.$FUSION_ENVIRONMENT.$extension" ]; then
              config="app.config.$FUSION_ENVIRONMENT.$extension"
              break
            fi
          done
          "$GITHUB_WORKSPACE/node_modules/.bin/fusion-framework-cli" app config "$config" --env "$FUSION_ENVIRONMENT" --output app-config.generated.json
      - name: Publish verified bundle
        uses: equinor/fusion-action-app-publish@c88d76012b79e374d0447915e84ba31e7b65d543 # v2.2.2
        with:
          # Absolute: the action resolves artifact paths against this value from inside it.
          working-directory: $\{{ github.workspace }}/$\{{ env.APP_DIRECTORY }}
          artifact: app-bundle.zip
          config: $\{{ env.PUBLISH_CONFIG == 'true' && 'app-config.generated.json' || '' }}
          env: $\{{ matrix.environment }}
          tag: $\{{ needs.released-app.outputs.tag }}
          azure-client-id: $\{{ vars[env.CLIENT_ID_VARIABLE] }}
          azure-tenant-id: $\{{ vars[env.TENANT_ID_VARIABLE] }}
          azure-resource-id: $\{{ vars[env.RESOURCE_ID_VARIABLE] }}
          allow-existing-version: "false"
